# ==========================================
# Database Configuration
# Local default: MySQL
# ==========================================
DB_ENGINE=mysql
DB_NAME=notification_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# On Render / Production:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# ==========================================
# Django Configuration
# ==========================================
SECRET_KEY=django-insecure-notification-system-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.render.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ==========================================
# 1. WhatsApp Cloud API (Sandbox)
# ==========================================
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_TEST_RECIPIENT=

# ==========================================
# 2. Transactional Email (Resend / Postmark)
# ==========================================
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# ==========================================
# 3. Web Push (VAPID Keys)
# ==========================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@notifications.com
